# Postgres (Compose)
POSTGRES_USER=pms
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=pms_db
POSTGRES_PORT=5432

# Edge proxy
NGINX_PORT=8080
NGINX_TLS_PORT=8443

# API process
ENV=development
PORT=8080
LOG_LEVEL=info
# Overridden inside Compose to use the postgres service hostname.
DATABASE_URL=postgres://pms:change-me-to-a-strong-password@127.0.0.1:5432/pms_db?sslmode=disable

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_TTL=60m
BCRYPT_COST=12

# Hospital A HIS
HOSPITAL_A_BASE_URL=https://hospital-a.api.co.th
HOSPITAL_A_TIMEOUT=5s

# Optional pool tuning
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2

VERSION=dev
